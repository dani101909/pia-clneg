# Copia este archivo a .env y ajusta. NUNCA subas .env a GitHub.

# Base de datos. SQLite para desarrollo local; PostgreSQL en produccion.
DATABASE_URL=sqlite:///cleanpro.db
# DATABASE_URL=postgresql://usuario:clave@host:5432/cleanpro

# Docker Compose (valores por defecto solo para desarrollo)
POSTGRES_USER=cleanpro
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=cleanpro

# 1 = carga datos de demostracion al arrancar (solo si la base esta vacia)
CLEANPRO_DEMO=1

# --- Autenticacion ---
# Secreto con el que se firman los tokens (minimo 16 caracteres). En produccion usa una
# cadena aleatoria larga y NO la compartas. Si falta, el servidor arranca con un secreto
# aleatorio y avisa en el log: las sesiones se pierden al reiniciar.
# Para generar una:  .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
CLEANPRO_SECRET=cambia-este-secreto-por-una-cadena-aleatoria-larga

# Contrasena de TODOS los usuarios de demo (cliente1, coord1, sup1, admin1...). Solo se usa
# con CLEANPRO_DEMO=1. Si falta, es "cleanpro123": cambiala en cualquier sitio publico.
CLEANPRO_CLAVE_DEMO=cambia-esta-clave-de-demo

# Puerto de la API (Render/Railway/Fly.io lo asignan solos)
PORT=8000
